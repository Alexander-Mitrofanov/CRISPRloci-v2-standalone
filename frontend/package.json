{
  "name": "crisprloci-v2",
  "version": "2.13.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run scan:public",
    "check:boundaries": "node scripts/check-agent-boundaries.mjs",
    "check:source": "npm run format:check && npm run lint && npm run check:boundaries",
