[Unit]
Description=CRISPRloci v2 API
Documentation=file:/srv/crisprloci-v2/README.md
After=local-fs.target network.target
RequiresMountsFor=/srv/crispr
StartLimitIntervalSec=5min
StartLimitBurst=3

[Service]
Type=exec
User=crisprsvc
Group=crisprsvc
WorkingDirectory=/srv/crisprloci-v2
EnvironmentFile=/etc/crisprloci.env
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONDONTWRITEBYTECODE=1
UnsetEnvironment=PYTHONPATH PYTHONHOME PYTHONSTARTUP PYTHONINSPECT PYTHONBREAKPOINT PYTHONWARNINGS PYTHONPLATLIBDIR PYTHONUSERBASE PYTHONEXECUTABLE __PYVENV_LAUNCHER__ LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT LD_DEBUG LD_DEBUG_OUTPUT LD_PROFILE GCONV_PATH GLIBC_TUNABLES BASH_ENV ENV SHELLOPTS BASHOPTS CDPATH IFS
ExecStart=/usr/bin/python3 -B -s /srv/crisprloci-v2/scripts/serve.py --service api
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
LogRateLimitIntervalSec=1min
LogRateLimitBurst=60

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
# All three units intentionally share crisprsvc. Per-unit IPC removal could
# tear down objects owned by a still-running scientific worker.
RemoveIPC=no
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
ReadWritePaths=/srv/crispr/jobs/web
LimitNOFILE=8192
LimitCORE=0
TasksMax=256
MemoryAccounting=yes
MemoryMax=1G
MemorySwapMax=0
MemoryZSwapMax=0
IOAccounting=yes
IOWeight=50
# Keep public API traffic responsive without allowing it to saturate shared storage.
# Bandwidth suffixes are decimal SI units as defined by systemd.
# The 1000/500 read/write IOPS ceilings bound small-file and metadata churn.
IOReadBandwidthMax=/srv/crispr 64M
IOWriteBandwidthMax=/srv/crispr 16M
IOReadIOPSMax=/srv/crispr 1000
IOWriteIOPSMax=/srv/crispr 500
OOMPolicy=stop

[Install]
WantedBy=multi-user.target
