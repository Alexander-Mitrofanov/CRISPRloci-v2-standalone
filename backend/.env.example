# Runtime paths and identities are supplied by scripts/serve.py.
# Filesystem and durable queue (owned by the unprivileged crisprsvc account)
CRISPR_WEB_DATA_ROOT=/srv/crispr/jobs/web
# Optional immutable reference catalogue, kept outside the job queue and frontend.
# CRISPR_WEB_CATALOG_DATABASE=/srv/crispr/catalogs/crisprcasdb-YYYYMMDD/catalog.sqlite3
CRISPR_WEB_DATABASE=/srv/crispr/jobs/web/queue.sqlite3

# Operator-owned executable configuration. This is never accepted from users.
CRISPR_WEB_WORKER_CPU=8
CRISPR_WEB_IDENTIFY_FOLDER_JOBS=1
CRISPR_WEB_STAGE_TIMEOUT_SECONDS=7200
CRISPR_WEB_JOB_TIMEOUT_SECONDS=21900
CRISPR_WEB_WORKER_POLL_SECONDS=2
CRISPR_WEB_WORKER_LEASE_SECONDS=30
CRISPR_WEB_WORKER_STALE_SECONDS=90
CRISPR_WEB_DISABLE_BIAS_CORRECTIONS=false

# Exact browser origins only; no wildcard is permitted.
CRISPR_WEB_CORS_ORIGINS=https://YOUR_GITHUB_USER.github.io
# Only set this to the private address range of the local TLS reverse proxy.
CRISPR_WEB_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Public queue, input, and retention limits
CRISPR_WEB_MAX_REQUEST_BYTES=4500000
CRISPR_WEB_MAX_TOTAL_BASES=2000000
CRISPR_WEB_MAX_RECORD_BASES=2000000
CRISPR_WEB_MAX_RECORDS=20
CRISPR_WEB_MAX_HEADER_CHARACTERS=200
CRISPR_WEB_MAX_QUEUED_JOBS=8
CRISPR_WEB_MAX_JOB_ATTEMPTS=2
CRISPR_WEB_RATE_LIMIT_SUBMISSIONS=4
CRISPR_WEB_RATE_LIMIT_WINDOW_SECONDS=3600
CRISPR_WEB_GLOBAL_RATE_LIMIT_SUBMISSIONS=30
CRISPR_WEB_GLOBAL_RATE_LIMIT_WINDOW_SECONDS=60
CRISPR_WEB_RETENTION_SECONDS=86400

# Bounded public summary and artifact postprocessing
CRISPR_WEB_MAX_SUMMARY_ARRAYS=1000
CRISPR_WEB_MAX_SUMMARY_ROWS=1000
CRISPR_WEB_MAX_BUNDLE_FILES=5000
CRISPR_WEB_MAX_ARTIFACT_FILE_BYTES=256000000
CRISPR_WEB_MAX_ARCHIVE_BYTES=512000000
CRISPR_WEB_MAX_JOB_DISK_BYTES=2000000000
CRISPR_WEB_MAX_JOB_ENTRIES=50000
CRISPR_WEB_MAX_LAUNCHER_LOG_BYTES=20000000
CRISPR_WEB_MIN_FREE_BYTES=2000000000
CRISPR_WEB_MIN_FREE_INODES=100000
CRISPR_WEB_JOB_DISK_CHECK_SECONDS=1

# Transport policy (release identities are supplied by scripts/serve.py)
CRISPR_WEB_HSTS=true

# Optional immutable CRISPRmap annotated reference (requires release-pinned crisprmap).
# CRISPR_WEB_REPEAT_REFERENCE=/absolute/operator/reference.json
# CRISPR_WEB_REPEAT_REFERENCE_SHA256=<64-lowercase-hex-digest>

# Optional immutable SpacePHARER phage reference. Prepare outside jobs; absence disables the mode.
# CRISPR_WEB_ASSOCIATION_REFERENCE=/absolute/operator/panels/my-panel
# CRISPR_WEB_ASSOCIATION_REFERENCE_SHA256=<SHA-256 of reference.json>
