      ],
      "not": {
        "required": [
          "reason"
        ]
      }
    },
    {
      "properties": {
        "complete": {
          "const": false
        }
      },
      "required": [
        "reason"
      ],
      "not": {
        "required": [
          "data"
        ]
      }
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "module": {
            "const": "detection"
          },
          "complete": {
            "const": true
          }
        }
      },
